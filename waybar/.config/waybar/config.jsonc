{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 0,
    "reload_style_on_change": true,

    // Islands hang from the top edge, like a notch
    "margin-left": 12,
    "margin-right": 12,

    // The clock stays dead center; media is its own island, centered in
    // the space between the workspaces and the clock
    "fixed-center": true,
    "expand-left": true,
    "modules-left": ["sway/workspaces", "custom/space#before-media", "mpris", "custom/space#after-media"],
    "modules-center": ["clock"],
    "modules-right": ["group/right"],

    // One dot per open workspace: ● is the current one
    "sway/workspaces": {
        "disable-scroll": true,
        "format": "{icon}",
        "format-icons": {
            "focused": "●",
            "urgent": "●",
            "default": "○"
        }
    },

    // Invisible spacers that keep the media island centered
    "custom/space#before-media": { "format": " ", "expand": true, "tooltip": false },
    "custom/space#after-media": { "format": " ", "expand": true, "tooltip": false },

    // Media: icon, app and title, only while something is playing.
    // Left click: mini player, right click: focus the app
    "mpris": {
        "format": "{player_icon}  {player} · {title}",
        "max-length": 60,
        "format-paused": "",
        "format-stopped": "",
        "player-icons": {
            "default": "",
            "firefox": "",
            "chromium": "",
            "spotify": ""
        },
        "tooltip": false,
        "on-click": "~/.config/waybar/panel.py media",
        "on-click-right": "~/.config/waybar/media-focus.sh",
        "on-click-middle": "playerctl play-pause"
    },

    // Date and time. Click: calendar + notifications
    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip": false,
        "on-click": "~/.config/waybar/panel.py calendar"
    },

    // Tray and general menu share the right island
    "group/right": {
        "orientation": "horizontal",
        "modules": ["tray", "custom/menu"]
    },

    // Tray icons (Spotify crashes on startup without a tray host)
    "tray": {
        "icon-size": 14,
        "spacing": 8
    },

    // General menu: audio devices, volume and power
    "custom/menu": {
        "format": "",
        "tooltip": false,
        "on-click": "~/.config/waybar/panel.py menu"
    }
}
