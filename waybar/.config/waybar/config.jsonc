{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 0,
    "reload_style_on_change": true,

    // Islands hang from the top edge, like a notch
    "margin-left": 12,
    "margin-right": 12,

    // The clock stays dead center; media is its own island, centered in
    // the space between the workspaces and the clock
    "fixed-center": true,
    "expand-left": true,
    "modules-left": ["group/left", "custom/space#before-media", "mpris", "custom/space#after-media"],
    "modules-center": ["clock"],
    "modules-right": ["group/right"],

    // Tux and the workspaces share the left island
    "group/left": {
        "orientation": "horizontal",
        "modules": ["custom/distro", "sway/workspaces"]
    },

    // Logo of the running distro (distro-icon.sh); opens the launcher
    "custom/distro": {
        "exec": "~/.config/waybar/distro-icon.sh",
        "interval": "once",
        "format": "<span font_size='11pt' rise='-1pt'>{}</span>",
        "tooltip": false,
        "on-click": "~/.config/sway/launcher.sh"
    },

    // The number of each open workspace; the current one is bright
    "sway/workspaces": {
        "disable-scroll": true,
        "format": "{name}"
    },

    // Invisible spacers that keep the media island centered
    "custom/space#before-media": { "format": " ", "expand": true, "tooltip": false },
    "custom/space#after-media": { "format": " ", "expand": true, "tooltip": false },

    // Media: icon, app and title, only while something is playing.
    // Left click: mini player, right click: focus the app
    "mpris": {
        "format": "{player_icon}  {player} · {title}",
        "max-length": 60,
        "format-paused": "",
        "format-stopped": "",
        "player-icons": {
            "default": "",
            "firefox": "",
            "chromium": "",
            "spotify": ""
        },
        "tooltip": false,
        "on-click": "~/.config/waybar/panel.py media",
        "on-click-right": "~/.config/waybar/media-focus.sh",
        "on-click-middle": "playerctl play-pause"
    },

    // Date and time. Click: calendar + notifications
    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip": false,
        "on-click": "~/.config/waybar/panel.py calendar"
    },

    // Battery, tray and general menu share the right island
    "group/right": {
        "orientation": "horizontal",
        "modules": ["battery", "tray", "custom/menu"]
    },

    // Only shows up on machines with a battery (laptops); a bolt while
    // charging, and it turns bright (style.css)
    "battery": {
        "format": "<span font_size='10pt' rise='-1pt'>{icon}</span> {capacity}%",
        "format-charging": "<span font_size='10pt' rise='-1pt'>\uf0e7</span> {capacity}%",
        "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
        "states": { "warning": 20, "critical": 10 },
        "tooltip-format": "{timeTo}"
    },

    // Tray icons (Spotify crashes on startup without a tray host)
    "tray": {
        "icon-size": 14,
        "spacing": 8
    },

    // General menu: audio devices, volume and power
    "custom/menu": {
        "format": "<span font_size='10pt' rise='-1pt'>\uf0c9</span>",
        "tooltip": false,
        "on-click": "~/.config/waybar/panel.py menu"
    }
}
