{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 0,
    "reload_style_on_change": true,

    // Islands hang from the top edge, like a notch. 6px margins: with the
    // 6px notch curve, the island body lines up with the windows (12px)
    "margin-left": 6,
    "margin-right": 6,

    // The clock stays dead center; media is its own island, centered in
    // the space between the workspaces and the clock
    "fixed-center": true,
    "expand-left": true,
    "modules-left": ["group/left", "custom/space#before-media", "mpris", "custom/space#after-media"],
    "modules-center": ["clock"],
    "modules-right": ["custom/updates", "group/right"],

    // Tux and the workspaces share the left island
    "group/left": {
        "orientation": "horizontal",
        "modules": ["custom/distro", "sway/workspaces"]
    },

    // Logo of the running distro (distro-icon.sh); opens the launcher
    "custom/distro": {
        "exec": "~/.config/waybar/distro-icon.sh",
        "interval": "once",
        "format": "<span font_size='11pt' rise='-1pt'>{}</span>",
        "tooltip": false,
        "on-click": "~/.config/sway/launcher.sh"
    },

    // The number of each open workspace; the current one is bright
    "sway/workspaces": {
        "disable-scroll": true,
        "format": "{name}"
    },

    // Invisible spacers that keep the media island centered
    "custom/space#before-media": { "format": " ", "expand": true, "tooltip": false },
    "custom/space#after-media": { "format": " ", "expand": true, "tooltip": false },

    // Media: app icon, artist and title, only while something is playing.
    // Left click: mini player, right click: focus the app
    "mpris": {
        "format": "{player_icon}  {artist} · {title}",
        "max-length": 60,
        "player-icons": {
            "default": "",
            "firefox": "\ue007",
            "chromium": "",
            "spotify": ""
        },
        "tooltip": false,
        "on-click": "~/.config/waybar/media-click.sh panel",
        "on-click-right": "~/.config/waybar/media-click.sh focus",
        "on-click-middle": "~/.config/waybar/media-click.sh toggle"
    },

    // Date and time. Click: calendar + notifications
    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip": false,
        "on-click": "~/.config/waybar/panel.py calendar"
    },

    // Pending updates: its own island, only while there are some.
    // Checked every 30 min (updates.py); signal 8 refreshes it after updating
    "custom/updates": {
        "exec": "~/.config/waybar/updates.py bar",
        "return-type": "json",
        "interval": 1800,
        "signal": 8,
        "tooltip": false,
        "on-click": "~/.config/waybar/panel.py updates"
    },

    // System stats, network, battery, tray and the general menu share the
    // right island
    "group/right": {
        "orientation": "horizontal",
        "modules": ["cpu", "memory", "battery", "network", "tray", "custom/menu"]
    },

    "cpu": {
        "format": "<span font_size='10pt' rise='-1pt'>\uf2db</span> {usage}%",
        "interval": 5,
        "tooltip": false
    },

    "memory": {
        "format": "<span font_size='10pt' rise='-1pt'>\uf538</span> {used:0.1f}G",
        "interval": 5,
        "tooltip": false
    },

    // Cable or Wi-Fi at a glance; click: network popup (Wi-Fi list open)
    "network": {
        "format-ethernet": "<span font_size='10pt' rise='-1pt'>\uf0e8</span>",
        "format-wifi": "<span font_size='10pt' rise='-1pt'>\uf1eb</span>",
        "format-linked": "<span font_size='10pt' rise='-1pt'>\uf0e8</span>",
        "format-disconnected": "<span font_size='10pt' rise='-1pt'>\uf00d</span>",
        "tooltip-format-ethernet": "Wired · {ifname} · {ipaddr}",
        "tooltip-format-wifi": "{essid} · {signalStrength}% · {ipaddr}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "~/.config/waybar/panel.py network"
    },

    // Only shows up on machines with a battery (laptops); a bolt while
    // charging, and it turns bright (style.css)
    "battery": {
        "format": "<span font_size='10pt' rise='-1pt'>{icon}</span> {capacity}%",
        "format-charging": "<span font_size='10pt' rise='-1pt'>\uf0e7</span> {capacity}%",
        "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
        "states": { "warning": 20, "critical": 10 },
        "tooltip-format": "{timeTo}"
    },

    // Tray icons (Spotify crashes on startup without a tray host)
    "tray": {
        "icon-size": 14,
        "spacing": 8
    },

    // General menu: audio devices, volume and power
    "custom/menu": {
        "format": "<span font_size='10pt' rise='-1pt'>\uf0c9</span>",
        "tooltip": false,
        "on-click": "~/.config/waybar/panel.py menu"
    }
}
