font=JetBrains Mono 10
border-size=0
border-radius=6
padding=12
margin=8
width=320
anchor=top-right
default-timeout=5000
# Kept for the notifications list in the calendar panel
max-history=30

# Colors come from the palette (`theme`)
include=~/.config/mako/colors

# On-screen indicator for volume (and brightness): small, bottom center,
# gone in 1.5s and never kept in the history
[category=osd]
anchor=bottom-center
width=240
margin=0,0,72,0
default-timeout=1500
history=0
format=<b>%s</b>
