  // Code: mostly gray, with the terminal's soft colors as accents
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": { "foreground": "#777777", "fontStyle": "italic" }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword", "keyword.control", "storage", "storage.type", "storage.modifier",
        "keyword.operator.new", "keyword.operator.expression", "keyword.operator.logical.python",
        "keyword.operator.wordlike", "variable.language.this", "variable.language.self",
        "variable.language.super"
      ],
      "settings": { "foreground": "#c2a0d2" }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator", "punctuation", "meta.brace", "punctuation.separator",
        "punctuation.terminator", "punctuation.accessor"
      ],
      "settings": { "foreground": "#8a8a8a" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"],
      "settings": { "foreground": "#a6c79c" }
    },
    {
      "name": "Escapes and regex",
      "scope": ["constant.character.escape", "string.regexp", "constant.other.placeholder"],
      "settings": { "foreground": "#92c6c6" }
    },
    {
      "name": "Template expressions",
      "scope": ["punctuation.definition.template-expression", "punctuation.section.embedded"],
      "settings": { "foreground": "#c2a0d2" }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric", "constant.language", "constant.character", "constant.other",
        "support.constant", "variable.other.constant", "variable.other.enummember"
      ],
      "settings": { "foreground": "#d6c28c" }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function", "support.function", "meta.function-call.generic",
        "variable.function", "entity.name.function.member"
      ],
      "settings": { "foreground": "#92aad6" }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type", "entity.name.class", "entity.name.namespace", "support.type",
        "support.class", "entity.other.inherited-class", "storage.type.primitive",
        "entity.name.type.interface", "entity.name.type.alias"
      ],
      "settings": { "foreground": "#92c6c6" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other", "meta.definition.variable", "variable.other.readwrite"],
      "settings": { "foreground": "#d0d0d0" }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter", "meta.parameter"],
      "settings": { "foreground": "#d0d0d0", "fontStyle": "italic" }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property", "variable.other.object.property", "support.variable.property",
        "meta.object-literal.key", "entity.name.variable.field"
      ],
      "settings": { "foreground": "#d0d0d0" }
    },
    {
      "name": "Decorators",
      "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.decorator"],
      "settings": { "foreground": "#d6c28c" }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#92aad6" }
    },
    {
      "name": "Tag brackets",
      "scope": ["punctuation.definition.tag"],
      "settings": { "foreground": "#555555" }
    },
    {
      "name": "Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#d6c28c" }
    },
    {
      "name": "CSS",
      "scope": ["support.type.property-name.css", "support.type.vendored.property-name"],
      "settings": { "foreground": "#d0d0d0" }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.pseudo-class", "entity.other.attribute-name.pseudo-element"
      ],
      "settings": { "foreground": "#92c6c6" }
    },
    {
      "name": "Keys (JSON, YAML, TOML, INI)",
      "scope": [
        "support.type.property-name", "entity.name.tag.yaml", "keyword.key.toml",
        "support.type.property-name.toml", "keyword.other.definition.ini", "entity.name.tag.toml"
      ],
      "settings": { "foreground": "#92aad6" }
    },
    {
      "name": "Sections (TOML, INI)",
      "scope": ["entity.name.section", "entity.name.table.toml"],
      "settings": { "foreground": "#ffffff", "fontStyle": "bold" }
    },
    {
      "name": "Shell variables",
      "scope": ["variable.other.normal.shell", "punctuation.definition.variable.shell", "variable.other.special.shell"],
      "settings": { "foreground": "#92c6c6" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section.markdown", "punctuation.definition.heading.markdown"],
      "settings": { "foreground": "#ffffff", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#ffffff", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "name": "Markdown code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block.markdown punctuation.definition", "markup.raw"],
      "settings": { "foreground": "#a6c79c" }
    },
    {
      "name": "Markdown links",
      "scope": ["markup.underline.link", "string.other.link", "meta.link"],
      "settings": { "foreground": "#92aad6" }
    },
    {
      "name": "Markdown quotes and lists",
      "scope": ["markup.quote", "punctuation.definition.list.begin.markdown"],
      "settings": { "foreground": "#777777" }
    },
    {
      "name": "Diff",
      "scope": ["markup.inserted", "meta.diff.header.to-file"],
      "settings": { "foreground": "#a6c79c" }
    },
    {
      "name": "Diff deleted",
      "scope": ["markup.deleted", "meta.diff.header.from-file"],
      "settings": { "foreground": "#d48282" }
    },
    {
      "name": "Diff changed",
      "scope": ["markup.changed", "meta.diff.range"],
      "settings": { "foreground": "#d6c28c" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#d48282" }
    }
  ],

  "semanticTokenColors": {
    "variable": "#d0d0d0",
    "variable.readonly": "#d0d0d0",
    "variable.defaultLibrary": "#d6c28c",
    "property": "#d0d0d0",
    "parameter": { "foreground": "#d0d0d0", "italic": true },
    "function": "#92aad6",
    "method": "#92aad6",
    "function.defaultLibrary": "#92aad6",
    "class": "#92c6c6",
    "interface": "#92c6c6",
    "type": "#92c6c6",
    "typeParameter": "#92c6c6",
    "enum": "#92c6c6",
    "enumMember": "#d6c28c",
    "namespace": "#92c6c6",
    "decorator": "#d6c28c",
    "keyword": "#c2a0d2",
    "selfParameter": "#c2a0d2",
    "builtinConstant": "#d6c28c",
    "magicFunction": "#92aad6"
  }
}
