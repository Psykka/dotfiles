# Generated by `theme` from ~/dotfiles/themes. Edit the palette, not this file.

# Background
output * bg #{{bg1}} solid_color

# Border colors: only the focused window shows one; the rest match
# the background color so they disappear
#                              border   bg       text     indicator child_border
client.focused                 #{{accent}}  #{{bg0}}  #{{hi}}  #{{accent}}   #{{accent}}
client.focused_inactive        #{{bg1}}  #{{bg0}}  #{{mute}}  #{{bg1}}   #{{bg1}}
client.unfocused               #{{bg1}}  #{{bg0}}  #{{mute}}  #{{bg1}}   #{{bg1}}
client.urgent                  #{{bg1}}  #{{bg0}}  #{{mute}}  #{{bg1}}   #{{bg1}}

# Light or dark for GTK apps (Firefox and portals read these)
exec_always gsettings set org.gnome.desktop.interface color-scheme {{scheme}} && gsettings set org.gnome.desktop.interface gtk-theme {{gtk_theme}}
