// Generated by `theme` from ~/dotfiles/themes. Edit the palette, not this file.
{
  "name": "Dotfiles",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    // Base: everything sits on the window color, split by thin lines
    "foreground": "#{{fg}}",
    "descriptionForeground": "#{{mute}}",
    "disabledForeground": "#{{off}}",
    "errorForeground": "#{{red}}",
    "focusBorder": "#{{faint}}",
    "contrastBorder": "#00000000",
    "widget.border": "#{{line}}",
    "widget.shadow": "#{{shadow}}",
    "selection.background": "#{{faint}}",
    "icon.foreground": "#{{sub}}",
    "sash.hoverBorder": "#{{faint}}",
    "textLink.foreground": "#{{blue}}",
    "textLink.activeForeground": "#{{bright_blue}}",
    "textPreformat.foreground": "#{{fg}}",
    "textPreformat.background": "#{{bg2}}",
    "textBlockQuote.background": "#{{bg1}}",
    "textBlockQuote.border": "#{{line}}",
    "textCodeBlock.background": "#{{bg1}}",
    "textSeparator.foreground": "#{{line}}",

    // Title bar, activity bar, side bar, panel, status bar
    "titleBar.activeBackground": "#{{bg0}}",
    "titleBar.activeForeground": "#{{sub}}",
    "titleBar.inactiveBackground": "#{{bg0}}",
    "titleBar.inactiveForeground": "#{{off}}",
    "titleBar.border": "#{{line}}",
    "menu.background": "#{{bg1}}",
    "menu.foreground": "#{{fg}}",
    "menu.selectionBackground": "#{{bg2}}",
    "menu.selectionForeground": "#{{hi}}",
    "menu.separatorBackground": "#{{line}}",
    "menu.border": "#{{line}}",
    "menubar.selectionBackground": "#{{bg2}}",
    "commandCenter.background": "#{{bg1}}",
    "commandCenter.foreground": "#{{sub}}",
    "commandCenter.activeBackground": "#{{bg2}}",
    "commandCenter.border": "#{{line}}",

    "activityBar.background": "#{{bg0}}",
    "activityBar.foreground": "#{{hi}}",
    "activityBar.inactiveForeground": "#{{off}}",
    "activityBar.activeBorder": "#{{accent}}",
    "activityBar.border": "#{{line}}",
    "activityBarBadge.background": "#{{accent}}",
    "activityBarBadge.foreground": "#{{bg0}}",

    "sideBar.background": "#{{bg0}}",
    "sideBar.foreground": "#{{sub}}",
    "sideBar.border": "#{{line}}",
    "sideBarTitle.foreground": "#{{mute}}",
    "sideBarSectionHeader.background": "#{{bg0}}",
    "sideBarSectionHeader.foreground": "#{{sub}}",
    "sideBarSectionHeader.border": "#{{line}}",

    "panel.background": "#{{bg0}}",
    "panel.border": "#{{line}}",
    "panelTitle.activeForeground": "#{{hi}}",
    "panelTitle.inactiveForeground": "#{{off}}",
    "panelTitle.activeBorder": "#{{accent}}",
    "panelSection.border": "#{{line}}",
    "panelSectionHeader.background": "#{{bg0}}",

    "statusBar.background": "#{{bg0}}",
    "statusBar.foreground": "#{{mute}}",
    "statusBar.border": "#{{line}}",
    "statusBar.noFolderBackground": "#{{bg0}}",
    "statusBar.debuggingBackground": "#{{bg2}}",
    "statusBar.debuggingForeground": "#{{hi}}",
    "statusBar.debuggingBorder": "#{{line}}",
    "statusBarItem.hoverBackground": "#{{bg2}}",
    "statusBarItem.activeBackground": "#{{line}}",
    "statusBarItem.remoteBackground": "#{{bg0}}",
    "statusBarItem.remoteForeground": "#{{sub}}",
    "statusBarItem.prominentBackground": "#{{bg2}}",
    "statusBarItem.errorBackground": "#{{bg0}}",
    "statusBarItem.errorForeground": "#{{red}}",
    "statusBarItem.warningBackground": "#{{bg0}}",
    "statusBarItem.warningForeground": "#{{yellow}}",

    // Tabs and breadcrumbs
    "editorGroupHeader.tabsBackground": "#{{bg0}}",
    "editorGroupHeader.tabsBorder": "#{{line}}",
    "editorGroupHeader.noTabsBackground": "#{{bg0}}",
    "editorGroup.border": "#{{line}}",
    "editorGroup.emptyBackground": "#{{bg0}}",
    "editorGroup.dropBackground": "#{{bg2}}80",
    "tab.activeBackground": "#{{bg0}}",
    "tab.activeForeground": "#{{hi}}",
    "tab.activeBorderTop": "#{{accent}}",
    "tab.inactiveBackground": "#{{bg0}}",
    "tab.inactiveForeground": "#{{off}}",
    "tab.hoverBackground": "#{{bg1}}",
    "tab.hoverForeground": "#{{fg}}",
    "tab.border": "#{{line}}",
    "tab.unfocusedActiveForeground": "#{{sub}}",
    "tab.unfocusedActiveBorderTop": "#{{faint}}",
    "tab.unfocusedInactiveForeground": "#{{off}}",
    "tab.activeModifiedBorder": "#{{yellow}}",
    "tab.inactiveModifiedBorder": "#{{yellow}}80",
    "breadcrumb.background": "#{{bg0}}",
    "breadcrumb.foreground": "#{{off}}",
    "breadcrumb.focusForeground": "#{{fg}}",
    "breadcrumb.activeSelectionForeground": "#{{hi}}",
    "breadcrumbPicker.background": "#{{bg1}}",

    // Editor
    "editor.background": "#{{bg0}}",
    "editor.foreground": "#{{fg}}",
    "editorLineNumber.foreground": "#{{faint}}",
    "editorLineNumber.activeForeground": "#{{sub}}",
    "editorCursor.foreground": "#{{fg}}",
    "editorCursor.background": "#{{bg0}}",
    "editor.lineHighlightBackground": "#{{bg1}}",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#{{faint}}99",
    "editor.inactiveSelectionBackground": "#{{line}}99",
    "editor.selectionHighlightBackground": "#{{line}}99",
    "editor.wordHighlightBackground": "#{{line}}99",
    "editor.wordHighlightStrongBackground": "#{{faint}}66",
    "editor.findMatchBackground": "#{{yellow}}55",
    "editor.findMatchBorder": "#{{yellow}}",
    "editor.findMatchHighlightBackground": "#{{yellow}}25",
    "editor.findRangeHighlightBackground": "#{{bg2}}",
    "editor.rangeHighlightBackground": "#{{bg2}}80",
    "editor.hoverHighlightBackground": "#{{line}}80",
    "editor.foldBackground": "#{{bg1}}",
    "editorLink.activeForeground": "#{{blue}}",
    "editorWhitespace.foreground": "#{{line}}",
    "editorIndentGuide.background1": "#{{bg2}}",
    "editorIndentGuide.activeBackground1": "#{{faint}}",
    "editorRuler.foreground": "#{{bg2}}",
    "editorCodeLens.foreground": "#{{off}}",
    "editorInlayHint.background": "#{{bg1}}",
    "editorInlayHint.foreground": "#{{off}}",
    "editorBracketMatch.background": "#{{line}}",
    "editorBracketMatch.border": "#00000000",
    "editorBracketHighlight.foreground1": "#{{sub}}",
    "editorBracketHighlight.foreground2": "#{{mute}}",
    "editorBracketHighlight.foreground3": "#{{fg}}",
    "editorBracketHighlight.foreground4": "#{{sub}}",
    "editorBracketHighlight.foreground5": "#{{mute}}",
    "editorBracketHighlight.foreground6": "#{{fg}}",
    "editorBracketHighlight.unexpectedBracket.foreground": "#{{red}}",
    "editorStickyScroll.background": "#{{bg0}}",
    "editorStickyScrollHover.background": "#{{bg1}}",
    "editorOverviewRuler.border": "#00000000",
    "editorOverviewRuler.findMatchForeground": "#{{yellow}}80",
    "editorOverviewRuler.errorForeground": "#{{red}}",
    "editorOverviewRuler.warningForeground": "#{{yellow}}",
    "editorOverviewRuler.infoForeground": "#{{blue}}",
    "editorOverviewRuler.addedForeground": "#{{green}}80",
    "editorOverviewRuler.modifiedForeground": "#{{blue}}80",
    "editorOverviewRuler.deletedForeground": "#{{red}}80",
    "editorError.foreground": "#{{red}}",
    "editorWarning.foreground": "#{{yellow}}",
    "editorInfo.foreground": "#{{blue}}",
    "editorHint.foreground": "#{{mute}}",
    "editorUnnecessaryCode.opacity": "#00000088",
    "editorGutter.background": "#{{bg0}}",
    "editorGutter.addedBackground": "#{{green}}",
    "editorGutter.modifiedBackground": "#{{blue}}",
    "editorGutter.deletedBackground": "#{{red}}",
    "editorGhostText.foreground": "#{{off}}",

    "editorWidget.background": "#{{bg1}}",
    "editorWidget.foreground": "#{{fg}}",
    "editorWidget.border": "#{{line}}",
    "editorHoverWidget.background": "#{{bg1}}",
    "editorHoverWidget.border": "#{{line}}",
    "editorSuggestWidget.background": "#{{bg1}}",
    "editorSuggestWidget.border": "#{{line}}",
    "editorSuggestWidget.foreground": "#{{fg}}",
    "editorSuggestWidget.highlightForeground": "#{{hi}}",
    "editorSuggestWidget.focusHighlightForeground": "#{{hi}}",
    "editorSuggestWidget.selectedBackground": "#{{bg2}}",
    "editorSuggestWidget.selectedForeground": "#{{hi}}",
    "peekView.border": "#{{faint}}",
    "peekViewEditor.background": "#{{bg1}}",
    "peekViewEditor.matchHighlightBackground": "#{{yellow}}40",
    "peekViewResult.background": "#{{bg1}}",
    "peekViewResult.selectionBackground": "#{{bg2}}",
    "peekViewResult.matchHighlightBackground": "#{{yellow}}40",
    "peekViewTitle.background": "#{{bg1}}",
    "peekViewTitleLabel.foreground": "#{{hi}}",
    "peekViewTitleDescription.foreground": "#{{mute}}",

    "diffEditor.insertedTextBackground": "#{{green}}20",
    "diffEditor.removedTextBackground": "#{{red}}20",
    "diffEditor.insertedLineBackground": "#{{green}}12",
    "diffEditor.removedLineBackground": "#{{red}}12",
    "diffEditor.diagonalFill": "#{{line}}",

    "merge.currentHeaderBackground": "#{{green}}40",
    "merge.currentContentBackground": "#{{green}}15",
    "merge.incomingHeaderBackground": "#{{blue}}40",
    "merge.incomingContentBackground": "#{{blue}}15",

    // Lists, trees, inputs
    "list.activeSelectionBackground": "#{{bg2}}",
    "list.activeSelectionForeground": "#{{hi}}",
    "list.inactiveSelectionBackground": "#{{bg1}}",
    "list.inactiveSelectionForeground": "#{{fg}}",
    "list.hoverBackground": "#{{bg1}}",
    "list.hoverForeground": "#{{fg}}",
    "list.focusOutline": "#00000000",
    "list.focusAndSelectionOutline": "#00000000",
    "list.highlightForeground": "#{{hi}}",
    "list.focusHighlightForeground": "#{{hi}}",
    "list.dropBackground": "#{{bg2}}",
    "list.errorForeground": "#{{red}}",
    "list.warningForeground": "#{{yellow}}",
    "list.deemphasizedForeground": "#{{off}}",
    "tree.indentGuidesStroke": "#{{line}}",
    "tree.inactiveIndentGuidesStroke": "#{{bg2}}",

    "input.background": "#{{bg1}}",
    "input.foreground": "#{{fg}}",
    "input.border": "#{{line}}",
    "input.placeholderForeground": "#{{off}}",
    "inputOption.activeBackground": "#{{line}}",
    "inputOption.activeBorder": "#{{faint}}",
    "inputOption.activeForeground": "#{{hi}}",
    "inputValidation.errorBackground": "#{{bg1}}",
    "inputValidation.errorBorder": "#{{red}}",
    "inputValidation.warningBackground": "#{{bg1}}",
    "inputValidation.warningBorder": "#{{yellow}}",
    "inputValidation.infoBackground": "#{{bg1}}",
    "inputValidation.infoBorder": "#{{blue}}",
    "dropdown.background": "#{{bg1}}",
    "dropdown.listBackground": "#{{bg1}}",
    "dropdown.border": "#{{line}}",
    "dropdown.foreground": "#{{fg}}",
    "checkbox.background": "#{{bg1}}",
    "checkbox.border": "#{{line}}",
    "checkbox.foreground": "#{{fg}}",

    "quickInput.background": "#{{bg1}}",
    "quickInput.foreground": "#{{fg}}",
    "quickInputTitle.background": "#{{bg1}}",
    "quickInputList.focusBackground": "#{{bg2}}",
    "quickInputList.focusForeground": "#{{hi}}",
    "pickerGroup.border": "#{{line}}",
    "pickerGroup.foreground": "#{{mute}}",
    "keybindingLabel.background": "#{{bg2}}",
    "keybindingLabel.foreground": "#{{fg}}",
    "keybindingLabel.border": "#{{line}}",
    "keybindingLabel.bottomBorder": "#{{line}}",

    // Buttons and badges: light on dark, like the "Yes" buttons
    "button.background": "#{{accent}}",
    "button.foreground": "#{{bg0}}",
    "button.hoverBackground": "#{{hi}}",
    "button.border": "#00000000",
    "button.separator": "#{{bg0}}40",
    "button.secondaryBackground": "#{{bg2}}",
    "button.secondaryForeground": "#{{fg}}",
    "button.secondaryHoverBackground": "#{{line}}",
    "badge.background": "#{{bg2}}",
    "badge.foreground": "#{{fg}}",
    "progressBar.background": "#{{accent}}",
    "scrollbar.shadow": "#00000000",
    "scrollbarSlider.background": "#{{line}}80",
    "scrollbarSlider.hoverBackground": "#{{faint}}80",
    "scrollbarSlider.activeBackground": "#{{off}}80",

    "notifications.background": "#{{bg1}}",
    "notifications.foreground": "#{{fg}}",
    "notifications.border": "#{{line}}",
    "notificationCenterHeader.background": "#{{bg1}}",
    "notificationToast.border": "#{{line}}",
    "notificationsErrorIcon.foreground": "#{{red}}",
    "notificationsWarningIcon.foreground": "#{{yellow}}",
    "notificationsInfoIcon.foreground": "#{{blue}}",
    "notificationLink.foreground": "#{{blue}}",

    "settings.headerForeground": "#{{hi}}",
    "settings.modifiedItemIndicator": "#{{faint}}",
    "settings.focusedRowBackground": "#{{bg1}}",
    "settings.rowHoverBackground": "#{{bg1}}",
    "welcomePage.tileBackground": "#{{bg1}}",
    "welcomePage.tileHoverBackground": "#{{bg2}}",
    "walkThrough.embeddedEditorBackground": "#{{bg1}}",

    // Git and problems
    "gitDecoration.addedResourceForeground": "#{{green}}",
    "gitDecoration.untrackedResourceForeground": "#{{green}}",
    "gitDecoration.modifiedResourceForeground": "#{{yellow}}",
    "gitDecoration.stageModifiedResourceForeground": "#{{yellow}}",
    "gitDecoration.deletedResourceForeground": "#{{red}}",
    "gitDecoration.stageDeletedResourceForeground": "#{{red}}",
    "gitDecoration.renamedResourceForeground": "#{{cyan}}",
    "gitDecoration.conflictingResourceForeground": "#{{magenta}}",
    "gitDecoration.ignoredResourceForeground": "#{{faint}}",
    "gitDecoration.submoduleResourceForeground": "#{{mute}}",
    "problemsErrorIcon.foreground": "#{{red}}",
    "problemsWarningIcon.foreground": "#{{yellow}}",
    "problemsInfoIcon.foreground": "#{{blue}}",

    // Integrated terminal: same colors as Alacritty
    "terminal.background": "#{{bg0}}",
    "terminal.foreground": "#{{fg}}",
    "terminal.border": "#{{line}}",
    "terminal.selectionBackground": "#{{faint}}99",
    "terminalCursor.foreground": "#{{fg}}",
    "terminalCursor.background": "#{{bg0}}",
    "terminal.ansiBlack": "#{{black}}",
    "terminal.ansiRed": "#{{red}}",
    "terminal.ansiGreen": "#{{green}}",
    "terminal.ansiYellow": "#{{yellow}}",
    "terminal.ansiBlue": "#{{blue}}",
    "terminal.ansiMagenta": "#{{magenta}}",
    "terminal.ansiCyan": "#{{cyan}}",
    "terminal.ansiWhite": "#{{white}}",
    "terminal.ansiBrightBlack": "#{{bright_black}}",
    "terminal.ansiBrightRed": "#{{bright_red}}",
    "terminal.ansiBrightGreen": "#{{bright_green}}",
    "terminal.ansiBrightYellow": "#{{bright_yellow}}",
    "terminal.ansiBrightBlue": "#{{bright_blue}}",
    "terminal.ansiBrightMagenta": "#{{bright_magenta}}",
    "terminal.ansiBrightCyan": "#{{bright_cyan}}",
    "terminal.ansiBrightWhite": "#{{bright_white}}",

    "minimap.background": "#{{bg0}}",
    "minimapSlider.background": "#{{line}}60",
    "minimapSlider.hoverBackground": "#{{faint}}60",
    "minimapSlider.activeBackground": "#{{off}}60"
  },

  // Code: mostly gray, with the terminal's soft colors as accents
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": { "foreground": "#{{mute}}", "fontStyle": "italic" }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword", "keyword.control", "storage", "storage.type", "storage.modifier",
        "keyword.operator.new", "keyword.operator.expression", "keyword.operator.logical.python",
        "keyword.operator.wordlike", "variable.language.this", "variable.language.self",
        "variable.language.super"
      ],
      "settings": { "foreground": "#{{magenta}}" }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator", "punctuation", "meta.brace", "punctuation.separator",
        "punctuation.terminator", "punctuation.accessor"
      ],
      "settings": { "foreground": "#{{sub}}" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"],
      "settings": { "foreground": "#{{green}}" }
    },
    {
      "name": "Escapes and regex",
      "scope": ["constant.character.escape", "string.regexp", "constant.other.placeholder"],
      "settings": { "foreground": "#{{cyan}}" }
    },
    {
      "name": "Template expressions",
      "scope": ["punctuation.definition.template-expression", "punctuation.section.embedded"],
      "settings": { "foreground": "#{{magenta}}" }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric", "constant.language", "constant.character", "constant.other",
        "support.constant", "variable.other.constant", "variable.other.enummember"
      ],
      "settings": { "foreground": "#{{yellow}}" }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function", "support.function", "meta.function-call.generic",
        "variable.function", "entity.name.function.member"
      ],
      "settings": { "foreground": "#{{blue}}" }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type", "entity.name.class", "entity.name.namespace", "support.type",
        "support.class", "entity.other.inherited-class", "storage.type.primitive",
        "entity.name.type.interface", "entity.name.type.alias"
      ],
      "settings": { "foreground": "#{{cyan}}" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other", "meta.definition.variable", "variable.other.readwrite"],
      "settings": { "foreground": "#{{fg}}" }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter", "meta.parameter"],
      "settings": { "foreground": "#{{fg}}", "fontStyle": "italic" }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property", "variable.other.object.property", "support.variable.property",
        "meta.object-literal.key", "entity.name.variable.field"
      ],
      "settings": { "foreground": "#{{fg}}" }
    },
    {
      "name": "Decorators",
      "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.decorator"],
      "settings": { "foreground": "#{{yellow}}" }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#{{blue}}" }
    },
    {
      "name": "Tag brackets",
      "scope": ["punctuation.definition.tag"],
      "settings": { "foreground": "#{{off}}" }
    },
    {
      "name": "Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#{{yellow}}" }
    },
    {
      "name": "CSS",
      "scope": ["support.type.property-name.css", "support.type.vendored.property-name"],
      "settings": { "foreground": "#{{fg}}" }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.pseudo-class", "entity.other.attribute-name.pseudo-element"
      ],
      "settings": { "foreground": "#{{cyan}}" }
    },
    {
      "name": "Keys (JSON, YAML, TOML, INI)",
      "scope": [
        "support.type.property-name", "entity.name.tag.yaml", "keyword.key.toml",
        "support.type.property-name.toml", "keyword.other.definition.ini", "entity.name.tag.toml"
      ],
      "settings": { "foreground": "#{{blue}}" }
    },
    {
      "name": "Sections (TOML, INI)",
      "scope": ["entity.name.section", "entity.name.table.toml"],
      "settings": { "foreground": "#{{hi}}", "fontStyle": "bold" }
    },
    {
      "name": "Shell variables",
      "scope": ["variable.other.normal.shell", "punctuation.definition.variable.shell", "variable.other.special.shell"],
      "settings": { "foreground": "#{{cyan}}" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section.markdown", "punctuation.definition.heading.markdown"],
      "settings": { "foreground": "#{{hi}}", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#{{hi}}", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "name": "Markdown code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block.markdown punctuation.definition", "markup.raw"],
      "settings": { "foreground": "#{{green}}" }
    },
    {
      "name": "Markdown links",
      "scope": ["markup.underline.link", "string.other.link", "meta.link"],
      "settings": { "foreground": "#{{blue}}" }
    },
    {
      "name": "Markdown quotes and lists",
      "scope": ["markup.quote", "punctuation.definition.list.begin.markdown"],
      "settings": { "foreground": "#{{mute}}" }
    },
    {
      "name": "Diff",
      "scope": ["markup.inserted", "meta.diff.header.to-file"],
      "settings": { "foreground": "#{{green}}" }
    },
    {
      "name": "Diff deleted",
      "scope": ["markup.deleted", "meta.diff.header.from-file"],
      "settings": { "foreground": "#{{red}}" }
    },
    {
      "name": "Diff changed",
      "scope": ["markup.changed", "meta.diff.range"],
      "settings": { "foreground": "#{{yellow}}" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#{{red}}" }
    }
  ],

  "semanticTokenColors": {
    "variable": "#{{fg}}",
    "variable.readonly": "#{{fg}}",
    "variable.defaultLibrary": "#{{yellow}}",
    "property": "#{{fg}}",
    "parameter": { "foreground": "#{{fg}}", "italic": true },
    "function": "#{{blue}}",
    "method": "#{{blue}}",
    "function.defaultLibrary": "#{{blue}}",
    "class": "#{{cyan}}",
    "interface": "#{{cyan}}",
    "type": "#{{cyan}}",
    "typeParameter": "#{{cyan}}",
    "enum": "#{{cyan}}",
    "enumMember": "#{{yellow}}",
    "namespace": "#{{cyan}}",
    "decorator": "#{{yellow}}",
    "keyword": "#{{magenta}}",
    "selfParameter": "#{{magenta}}",
    "builtinConstant": "#{{yellow}}",
    "magicFunction": "#{{blue}}"
  }
}
