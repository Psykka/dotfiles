### Minimal sway config

set $mod Mod4

# Terminal
bindsym $mod+Return exec alacritty

# Files
bindsym $mod+e exec files

# Launcher, with "System" (the System menu) pinned at the top
bindsym $mod+space exec ~/.config/sway/launcher.sh

# Screenshot: saved to ~/Pictures/Screenshots and copied to the clipboard
bindsym Print exec ~/.config/sway/screenshot.sh screen
bindsym Shift+Print exec ~/.config/sway/screenshot.sh area
bindsym $mod+Shift+s exec ~/.config/sway/screenshot.sh area

# Clipboard history
bindsym $mod+v exec ~/.config/sway/clipboard.sh

# Keybindings: list and run
bindsym $mod+slash exec ~/.config/sway/keys.sh

# System menu: settings, tools and power
bindsym $mod+Escape exec ~/.config/sway/menu.sh

# Volume: media keys or Super+=/-, in steps of 5
bindsym --locked XF86AudioRaiseVolume exec ~/.config/sway/volume.sh up
bindsym --locked XF86AudioLowerVolume exec ~/.config/sway/volume.sh down
bindsym --locked XF86AudioMute exec ~/.config/sway/volume.sh mute
bindsym $mod+equal exec ~/.config/sway/volume.sh up
bindsym $mod+minus exec ~/.config/sway/volume.sh down

# Close window
bindsym $mod+Shift+q kill

# Floating windows: Super+F toggles; Super + left drag moves,
# Super + right drag resizes
bindsym $mod+f floating toggle
floating_modifier $mod normal

# Workspaces: go to / move window. Each display has its own 1..6
# (workspaces.py); with a single display they are just 1..6
bindsym $mod+1 exec ~/.config/sway/workspaces.py go 1
bindsym $mod+2 exec ~/.config/sway/workspaces.py go 2
bindsym $mod+3 exec ~/.config/sway/workspaces.py go 3
bindsym $mod+4 exec ~/.config/sway/workspaces.py go 4
bindsym $mod+5 exec ~/.config/sway/workspaces.py go 5
bindsym $mod+6 exec ~/.config/sway/workspaces.py go 6
bindsym $mod+Shift+1 exec ~/.config/sway/workspaces.py move 1
bindsym $mod+Shift+2 exec ~/.config/sway/workspaces.py move 2
bindsym $mod+Shift+3 exec ~/.config/sway/workspaces.py move 3
bindsym $mod+Shift+4 exec ~/.config/sway/workspaces.py move 4
bindsym $mod+Shift+5 exec ~/.config/sway/workspaces.py move 5
bindsym $mod+Shift+6 exec ~/.config/sway/workspaces.py move 6

# Send the window to the display on that side, onto the workspace it is
# showing, and follow it
bindsym $mod+Shift+Left move container to output left; focus output left
bindsym $mod+Shift+Right move container to output right; focus output right
bindsym $mod+Shift+Up move container to output up; focus output up
bindsym $mod+Shift+Down move container to output down; focus output down

# Workspaces: Super + scroll goes to the previous / next one of the display;
# past the last, it opens a new workspace
bindsym --whole-window $mod+button4 exec ~/.config/sway/workspaces.py prev
bindsym --whole-window $mod+button5 exec ~/.config/sway/workspaces.py next

# Laptops: three-finger swipe to the side changes workspace, like macOS
# (left = next, right = previous); does nothing without a touchpad
bindgesture swipe:3:left exec ~/.config/sway/workspaces.py next
bindgesture swipe:3:right exec ~/.config/sway/workspaces.py prev

# Reload config
bindsym $mod+Shift+r reload

# Polkit agent (password prompt); its path differs between distros
exec sh -c 'for a in /usr/libexec/polkit-mate-authentication-agent-1 /usr/lib/mate-polkit/polkit-mate-authentication-agent-1; do [ -x "$a" ] && exec "$a"; done'

# Lock: Super+L, or automatically after 20 min (never suspends)
bindsym $mod+l exec lock
exec swayidle -w timeout 1200 lock

# Keyboard: US ANSI with accents (dead keys)
input type:keyboard {
    xkb_layout us
    xkb_variant intl
}

# Mouse
focus_follows_mouse no

# Touchpad (laptops): tap to click, natural scrolling, ignore it while typing
input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt enabled
}

# systemd integration (sway-systemd)
include /etc/sway/config.d/*

# Borders and gaps
default_border pixel 2
default_floating_border pixel 2
smart_borders off
gaps inner 8
gaps outer 4
smart_gaps off

# Colors, background and SwayFX effects come from the palette
# (~/dotfiles/themes, applied with `theme dark|light|toggle`)
include ~/.config/sway/colors
include ~/.config/sway/fx.d/*

# Fonts and icons for GTK apps (Firefox and portals read these)
exec_always gsettings set org.gnome.desktop.interface font-name 'Inter 10' && gsettings set org.gnome.desktop.interface monospace-font-name 'JetBrains Mono 10' && gsettings set org.gnome.desktop.interface icon-theme Papirus-Mono

# Bar, notifications, media tracking and clipboard history
exec waybar
# Notifications (and the volume indicator); exec_always brings it back
# after a crash, and a second one just leaves
exec_always ~/.config/waybar/notifications.py daemon
exec playerctld daemon
# Puts back the microphone gains a headset loses on replug (Sound page)
exec ~/.config/waybar/audio.py watch
exec wl-paste --watch cliphist store

# Displays: main display, resolution, scale and order, set in the menu's
# Displays page (written by ~/.config/waybar/displays.py; none until then)
include ~/.local/state/sway-displays.conf

# Display profiles (~/.config/kanshi/config); does nothing without one, and
# overrides the Displays page when there is one
exec kanshi

# Workspaces per display: puts each display's workspaces back on it when
# displays are plugged in, unplugged or reordered
exec ~/.config/sway/workspaces.py watch

# Gorilla-like tiling: new windows halve the focused one, in a spiral
exec ~/.config/sway/autotiling.py

# Dialogs and small tool windows float, centered
for_window [window_type="dialog"] floating enable
for_window [window_role="dialog"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [app_id="polkit-mate-authentication-agent-1"] floating enable
for_window [app_id="xdg-desktop-portal-gtk"] floating enable
for_window [app_id="org.pulseaudio.pavucontrol"] floating enable
for_window [title="^Picture-in-Picture$"] floating enable, sticky enable
# Terminal with ufetch in the wallpaper preview (panel.py): invisible until
# the panel puts it in a corner
for_window [app_id="wallpaper-preview"] floating enable, opacity 0
