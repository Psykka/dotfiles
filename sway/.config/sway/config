### Minimal sway config

set $mod Mod4

# Terminal
bindsym $mod+Return exec alacritty

# Launcher
bindsym $mod+space exec fuzzel

# Screenshot (full screen) to ~/Pictures/Screenshots
bindsym Print exec mkdir -p ~/Pictures/Screenshots && grim ~/Pictures/Screenshots/$(date +'%Y-%m-%d_%H-%M-%S').png

# Keybindings: list and run
bindsym $mod+slash exec ~/.config/sway/keys.sh

# Menu: lock, log out, reboot, power off
bindsym $mod+Escape exec ~/.config/sway/menu.sh

# Volume: media keys or Super+=/-, in steps of 5
bindsym --locked XF86AudioRaiseVolume exec ~/.config/sway/volume.sh up
bindsym --locked XF86AudioLowerVolume exec ~/.config/sway/volume.sh down
bindsym --locked XF86AudioMute exec ~/.config/sway/volume.sh mute
bindsym $mod+equal exec ~/.config/sway/volume.sh up
bindsym $mod+minus exec ~/.config/sway/volume.sh down

# Close window
bindsym $mod+Shift+q kill

# Workspaces: go to / move window
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6

# Background
output * bg #222222 solid_color

# Reload config
bindsym $mod+Shift+r reload

# Polkit agent (password prompt)
exec /usr/libexec/polkit-mate-authentication-agent-1

# Lock: Super+L, or automatically after 20 min (never suspends)
bindsym $mod+l exec swaylock -f
exec swayidle -w timeout 1200 'swaylock -f'

# Keyboard: US ANSI with accents (dead keys)
input type:keyboard {
    xkb_layout us
    xkb_variant intl
}

# Mouse
focus_follows_mouse no

# systemd integration (sway-systemd)
include /etc/sway/config.d/*

# Borders and gaps
default_border pixel 2
default_floating_border pixel 2
smart_borders off
corner_radius 6
gaps inner 8
gaps outer 4
smart_gaps off

# Border colors       border  bg      text    indicator child_border
client.focused        #89b4fa #1e1e2e #cdd6f4 #89b4fa   #89b4fa
client.unfocused      #313244 #1e1e2e #6c7086 #313244   #313244

# Bar
bar {
    position top
    status_command ~/.config/sway/status.sh
    font pango:monospace 10
    height 22
    colors {
        background #1e1e2e
        statusline #cdd6f4
        separator  #1e1e2e
        #                  border  bg      text
        focused_workspace  #1e1e2e #1e1e2e #89b4fa
        active_workspace   #1e1e2e #1e1e2e #cdd6f4
        inactive_workspace #1e1e2e #1e1e2e #6c7086
        urgent_workspace   #f38ba8 #1e1e2e #f38ba8
    }
}
