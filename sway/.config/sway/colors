# Generated by `theme` from ~/dotfiles/themes. Edit the palette, not this file.

# Wallpaper, with the background color around it if the ratio differs
output * bg ~/.local/share/wallpapers/moon-earth.jpg fill #181818

# Border colors: only the focused window shows one; the rest match
# the background color so they disappear
#                              border   bg       text     indicator child_border
client.focused                 #e8e8e8  #121212  #ffffff  #e8e8e8   #e8e8e8
client.focused_inactive        #181818  #121212  #777777  #181818   #181818
client.unfocused               #181818  #121212  #777777  #181818   #181818
client.urgent                  #181818  #121212  #777777  #181818   #181818

# Light or dark for GTK apps (Firefox and portals read these)
exec_always gsettings set org.gnome.desktop.interface color-scheme prefer-dark && gsettings set org.gnome.desktop.interface gtk-theme Adwaita-dark
