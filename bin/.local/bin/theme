#!/usr/bin/env python3
"""Applies a color palette to every config.

Usage: theme [name]     apply a palette (default: the current one)
       theme current    print the current palette
       theme get KEY    print one value of the current palette
       theme set KEY VALUE  change one value (e.g. logo) and apply
       theme dump [base]    the whole palette as JSON (base: without local)
       theme local [KEY=VALUE ...]  print / change this machine's choices
                        and apply (an empty VALUE drops the key)
       theme preview KEY=VALUE ...  apply with these values, saving nothing
                        (with none: back to what is saved)

`local` and `preview` change only colors and the wallpaper, so they skip
`swaymsg reload` (it redraws everything and the screen blinks): sway gets
the colors as commands, and Waybar reloads only its style.

Fills the templates in ~/dotfiles/themes/templates with the palette in
~/dotfiles/themes/<name>.ini, writes them into the stow packages and
reloads sway and Waybar; the notifications follow on their own. GTK apps
pick it up when reopened.
The VSCode theme ("Dotfiles") is packed and installed when it changes;
VSCode picks it up after "Developer: Reload Window".

Choices of this machine (the wallpaper and its colors, picked in the
wallpaper panel) go in ~/.local/state/theme-local.ini, on top of the
palette, so they stay out of the repo. The files `theme` writes are not in
git either (.gitignore): the palettes and templates are the source.
"""
import json
import pathlib
import shutil
import subprocess
import sys
import tempfile
import zipfile

REPO = pathlib.Path(__file__).resolve().parents[3]
THEMES = REPO / "themes"
TEMPLATES = THEMES / "templates"
CURRENT = THEMES / "current"
LOCAL = pathlib.Path.home() / ".local/state/theme-local.ini"

# Templates that only make sense on SwayFX (rounded corners, shadows)
FX_ONLY = ("sway/.config/sway/fx.d/",)

# VSCode only loads extensions it installed itself, so the theme goes in
# as a .vsix instead of being linked with stow
VSCODE_EXT = REPO / "vscode-theme"
VSCODE_INSTALLED = pathlib.Path.home() / ".vscode/extensions/psykka.dotfiles-theme-1.0.0"
VSIX_MANIFEST = """<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011">
  <Metadata>
    <Identity Language="en-US" Id="dotfiles-theme" Version="1.0.0" Publisher="psykka"/>
    <DisplayName>Dotfiles</DisplayName>
    <Categories>Themes</Categories>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Code.Engine" Value="^1.70.0"/>
    </Properties>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Code"/>
  </Installation>
  <Dependencies/>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.Code.Manifest" Path="extension/package.json" Addressable="true"/>
  </Assets>
</PackageManifest>
"""
VSIX_TYPES = """<?xml version="1.0" encoding="utf-8"?>
<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">
  <Default Extension=".json" ContentType="application/json"/>
  <Default Extension=".vsixmanifest" ContentType="text/xml"/>
</Types>
"""


def is_swayfx():
    if not shutil.which("sway"):
        return True  # not installed yet: keep the effects
    out = subprocess.run(["sway", "--version"], capture_output=True, text=True).stdout
    return "swayfx" in out.lower()


def read_ini(path):
    values = {}
    for line in path.read_text().splitlines() if path.exists() else []:
        line = line.strip()
        if line and not line.startswith("#"):
            key, _, value = line.partition("=")
            values[key.strip()] = value.strip()
    return values


def load(name):
    return read_ini(THEMES / f"{name}.ini")


def palette(name, extra=None):
    """The palette with this machine's choices on top, and `extra` on top of
    both (an empty value there means the palette's own)."""
    base = load(name)
    values = dict(base)
    for key, value in read_ini(LOCAL).items():
        if key in values and value:
            values[key] = value
    for key, value in (extra or {}).items():
        values[key] = value or base[key]
    return values


def pairs(name, args):
    """KEY=VALUE arguments, checked against the palette."""
    known = load(name)
    out = {}
    for arg in args:
        key, sep, value = arg.partition("=")
        if not sep or key not in known:
            sys.exit(f"theme: {arg!r} is not KEY=VALUE with a key of {name}.ini")
        out[key] = value
    return out


def set_local(values):
    local = read_ini(LOCAL)
    local.update(values)
    local = {k: v for k, v in local.items() if v}
    LOCAL.parent.mkdir(parents=True, exist_ok=True)
    LOCAL.write_text("# This machine's theme choices (`theme local`), on top of the palette\n"
                     + "".join(f"{k}={v}\n" for k, v in local.items()))


def render(values):
    fx = is_swayfx()
    for tmpl in sorted(TEMPLATES.rglob("*")):
        if not tmpl.is_file():
            continue
        rel = str(tmpl.relative_to(TEMPLATES))
        text = tmpl.read_text()
        if not fx and rel.startswith(FX_ONLY):
            text = "# Empty: this is plain sway, not SwayFX\n"
        for key, value in values.items():
            text = text.replace("{{%s}}" % key, value)
        if "{{" in text:
            sys.exit(f"theme: {tmpl.relative_to(THEMES)} uses a color missing from the palette")
        out = REPO / tmpl.relative_to(TEMPLATES)
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(text)


def reload():
    for cmd in (["swaymsg", "reload"], ["pkill", "-USR2", "-x", "waybar"]):
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


SWAY_COLORS = ("sway/.config/sway/colors", "sway/.config/sway/fx.d/effects")


def sway_lines():
    lines = set()
    for rel in SWAY_COLORS:
        path = REPO / rel
        lines |= {l.strip() for l in path.read_text().splitlines()} if path.exists() else set()
    return lines


def reload_colors(before):
    """Just the colors, without a blink. `before`: sway_lines() from before
    rendering; the wallpaper is set again only if it changed."""
    commands = [l for l in sorted(sway_lines()) if l.startswith(("client.", "shadow_color"))
                or (l.startswith("output ") and l not in before)]
    if commands:
        subprocess.run(["swaymsg", "; ".join(commands)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    # reload_style_on_change: a newer style.css reloads the style (and the
    # colors.css it imports) without making the bar again
    (REPO / "waybar/.config/waybar/style.css").touch()


def install_vscode():
    if not shutil.which("code"):
        return
    files = [p for p in sorted(VSCODE_EXT.rglob("*")) if p.is_file()]
    # VSCode rewrites package.json when installing, so only the colors are compared
    colors = [p.relative_to(VSCODE_EXT) for p in files if p.parent.name == "themes"]
    if all((VSCODE_INSTALLED / c).is_file()
           and (VSCODE_INSTALLED / c).read_bytes() == (VSCODE_EXT / c).read_bytes() for c in colors):
        return
    with tempfile.TemporaryDirectory() as tmp:
        vsix = pathlib.Path(tmp) / "dotfiles-theme.vsix"
        with zipfile.ZipFile(vsix, "w") as z:
            z.writestr("extension.vsixmanifest", VSIX_MANIFEST)
            z.writestr("[Content_Types].xml", VSIX_TYPES)
            for p in files:
                z.write(p, "extension/" + str(p.relative_to(VSCODE_EXT)))
        subprocess.run(["code", "--install-extension", str(vsix), "--force"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def set_value(name, key, value):
    path = THEMES / f"{name}.ini"
    lines = path.read_text().splitlines()
    for i, line in enumerate(lines):
        if line.split("=", 1)[0].strip() == key and not line.lstrip().startswith("#"):
            lines[i] = f"{key}={value}"
            break
    else:
        sys.exit(f"theme: {key!r} is not in {path.name}")
    path.write_text("\n".join(lines) + "\n")


def main():
    current = CURRENT.read_text().strip() if CURRENT.exists() else "dark"
    arg = sys.argv[1] if len(sys.argv) > 1 else current
    if arg == "current":
        print(current)
        return
    if arg == "get" and len(sys.argv) == 3:
        print(palette(current).get(sys.argv[2], ""))
        return
    if arg == "dump":
        base = sys.argv[2:] == ["base"]
        print(json.dumps(load(current) if base else palette(current)))
        return
    if arg == "local" and len(sys.argv) == 2:
        for key, value in read_ini(LOCAL).items():
            print(f"{key}={value}")
        return
    if arg in ("preview", "local"):
        values = pairs(current, sys.argv[2:])
        before = sway_lines()
        if arg == "local":
            set_local(values)
            values = {}
        render(palette(current, values))
        reload_colors(before)
        if arg == "local":
            install_vscode()
        return
    if arg == "set" and len(sys.argv) == 4:
        set_value(current, sys.argv[2], sys.argv[3])
        arg = current
    name = arg
    if not (THEMES / f"{name}.ini").exists():
        sys.exit(f"theme: no palette named {name!r} in {THEMES}")
    render(palette(name))
    CURRENT.write_text(name + "\n")
    reload()
    install_vscode()
    print(f"theme: {name}")


if __name__ == "__main__":
    main()
