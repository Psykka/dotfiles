#!/bin/sh
# Runs the ufetch script of the running distro (ufetch by J Schillinger,
# MIT license: ~/dotfiles/licenses/ufetch). Fedora, Arch and Debian, and
# distros based on them.

dir=$(dirname "$(readlink -f "$0")")
. /etc/os-release
for id in $ID ${ID_LIKE:-}; do
    case $id in
        fedora|arch|debian) exec "$dir/ufetch-$id" ;;
        ubuntu) exec "$dir/ufetch-debian" ;;
    esac
done
echo "ufetch: no script for $ID" >&2
exit 1
